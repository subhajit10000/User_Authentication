
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173


MONGO_URI=mongodb+srv://<username>:<password>@cluster0.9r9pwgl.mongodb.net


ACCESS_TOKEN_SECRET=replace_with_a_long_random_access_secret
ACCESS_TOKEN_EXPIRES=15m


REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
REFRESH_TOKEN_EXPIRES=7d


JWT_ISSUER=AuthServer
JWT_AUDIENCE=AuthClient


COOKIE_SECRET=replace_with_a_long_random_cookie_secret
COOKIE_DOMAIN=localhost


CRYPTO_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRYPTO_ALGORITHM=aes-256-cbc
CRYPTO_IV=DVFHJFVDHVDJFDVF



BCRYPT_SALT_ROUNDS=12


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_user_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM=your_server_email@gmail.com


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100


MAX_FILE_SIZE=5242880


OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10


PASSWORD_RESET_EXPIRY_MINUTES=15


MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME_MINUTES=30


LOG_LEVEL=debug
